# ===== GeekOzon ERP 生产环境配置模板 =====
# 复制为 .env 并填写真实值：cp .env.example .env

# 关闭调试模式（生产必须为 0）
FLASK_DEBUG=0

# 会话密钥（必填！生成命令：python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=

# CORS 允许来源（逗号分隔；部署后填你的域名，如 https://erp.example.com）
CORS_ALLOWED_ORIGINS=*

# ===== AI 配置 =====
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ===== 图片公网托管（Ozon 只接受公网图片 URL，必配其一）=====
# 方案A：用你的域名直接暴露上传目录
IMAGE_BASE_URL=https://erp.example.com
# 方案B：图片转存七牛云对象存储（推荐，省心）
OBJECT_STORAGE_TYPE=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# ===== 价格换算 =====
EXCHANGE_RATE_CNY_TO_RUB=12.5
PROFIT_MARGIN=1.3
OLD_PRICE_RATIO=1.2
